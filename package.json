{
  "name": "doculedger",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready document intelligence platform with Stellar/Soroban-anchored verification.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @doculedger/api start:dev",
    "dev:worker": "pnpm --filter @doculedger/worker start:dev",
    "dev:web": "pnpm --filter @doculedger/web dev",
    "test": "pnpm -r --if-present test",
    "test:ci": "pnpm -r --if-present test:ci",
    "lint": "pnpm -r --if-present lint",
    "db:generate": "pnpm --filter @doculedger/database generate",
    "db:migrate": "pnpm --filter @doculedger/database migrate:dev",
    "db:seed": "pnpm --filter @doculedger/database seed",
    "prepare": "node -e \"try{require('husky')}catch(e){}\""
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
